    "info": {
        "title": "Good Timing Console \u2014 ingest",
        "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/v0/metrics/demand_intents": {
            "get": {
                "description": "What agents arrive to do on a vendor, ranked by distinct sessions.",
                "operationId": "demand_intents",
                "parameters": [
                    {
                        "description": "The vendor surface being asked about (a facet, not the tenant scope).",
                        "in": "query",
                        "name": "vendor_id",
                        "required": true,
                        "schema": {
                            "description": "The vendor surface being asked about (a facet, not the tenant scope).",
                            "title": "Vendor Id",
                            "type": "string"
                        }
                    },
                    {
                        "description": "Window on captured_at, in days back from now. Omit for all-time.",
                        "in": "query",
                        "name": "window_days",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "exclusiveMinimum": 0,
                                    "type": "integer"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Window on captured_at, in days back from now. Omit for all-time.",
                            "title": "Window Days"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AgentAnswer"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        },
                        "description": "Validation Error"
                    }
                },
                "security": [
                    {
                        "TenantId": []
                    },
                    {
                        "BearerApiKey": []
                    }
                ],
                "summary": "Demand Intents",
                "tags": [
                    "metrics"
                ]
            }
        },
