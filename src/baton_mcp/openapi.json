            "IncomingEvent": {
                "additionalProperties": false,
                "description": "SDK-emitted event envelope. Single event per POST.\n\n``payload`` stays as a plain dict on this side of the wire \u2014 the\nConsole stores it as JSONB and lets the worker parse per-event-type\nwhen it stitches signals.",
                "properties": {
                    "agent_runtime": {
                        "title": "Agent Runtime",
                        "type": "string"
                    },
                    "call_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Call Id"
                    },
                    "captured_at": {
                        "format": "date-time",
                        "title": "Captured At",
                        "type": "string"
                    },
                    "client_observed": {
                        "anyOf": [
                            {
                                "additionalProperties": true,
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Client Observed"
                    },
                    "consent_token": {
                        "title": "Consent Token",
                        "type": "string"
                    },
                    "event_id": {
                        "format": "uuid",
                        "title": "Event Id",
                        "type": "string"
                    },
                    "event_type": {
                        "enum": [
                            "tool_call_start",
                            "tool_call_end",
                            "tool_call_error",
                            "annotation",
                            "resource_list_start",
                            "resource_list_end",
                            "resource_list_error",
                            "resource_read_start",
                            "resource_read_end",
                            "resource_read_error",
                            "prompt_list_start",
                            "prompt_list_end",
                            "prompt_list_error",
                            "prompt_get_start",
                            "prompt_get_end",
                            "prompt_get_error",
                            "tool_list_start",
                            "tool_list_end",
                            "tool_list_error",
                            "surface_snapshot"
                        ],
                        "title": "Event Type",
                        "type": "string"
                    },
                    "payload": {
                        "additionalProperties": true,
                        "title": "Payload",
                        "type": "object"
                    },
                    "principal": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/PrincipalWire"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "principal_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Principal Id"
                    },
                    "runtime_meta": {
                        "anyOf": [
                            {
                                "additionalProperties": true,
                                "type": "object"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Runtime Meta"
                    },
                    "sdk_version": {
                        "title": "Sdk Version",
                        "type": "string"
                    },
                    "sequence_number": {
                        "minimum": 0.0,
                        "title": "Sequence Number",
                        "type": "integer"
                    },
                    "session_id": {
                        "title": "Session Id",
                        "type": "string"
                    },
                    "session_id_origin": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Session Id Origin"
                    },
                    "spec_version": {
                        "default": "0.1",
                        "title": "Spec Version",
                        "type": "string"
                    },
                    "tenant_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Tenant Id"
                    },
                    "transport_observed": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Transport Observed"
                    },
                    "vendor_id": {
                        "title": "Vendor Id",
                        "type": "string"
                    }
                },
                "required": [
                    "event_id",
                    "vendor_id",
                    "session_id",
                    "sequence_number",
                    "event_type",
                    "sdk_version",
                    "agent_runtime",
                    "captured_at",
                    "consent_token",
                    "payload"
                ],
                "title": "IncomingEvent",
                "type": "object"
            },
            "PrincipalWire": {
                "additionalProperties": false,
                "description": "SPEC \u00a711.4: who the vendor resolved behind the call, as ONE value.\n\n``id`` alone is not safe to read. Whether it is a pseudonym or a real\nname is not a fact *about* the value a consumer can look up later \u2014 it is\npart of what the value MEANS. The three members travel together so there\nis no conformant event carrying an ``id`` whose classification a reader\nhas to guess, which is why all three are REQUIRED here: a partial object\nis malformed, not a degraded reading. To say nobody was resolved, omit\n``principal`` entirely.\n\n\u26a0 **``source`` and ``form`` are plain ``str``, deliberately NOT\n``Literal``** \u2014 the same argument ``transport_observed`` records below. A\n422 drops the WHOLE event and the SDK discards a non-429 4xx without\nreading the body, so one unrecognised value would cost the call's\n``call_id`` too. SPEC \u00a711.4 states both consumer rules the safe way round\n(trust only ``attested``; treat anything but ``hashed`` as personal data),\nso an unknown value already fails safe downstream \u2014 and that is what makes\na fourth source, alias-derived, free to add later.\n\n``extra=\"forbid\"`` matches the envelope's: a new MEMBER lands here before\na producer emits it, the same ordering that governs new fields.",
                "properties": {
                    "display_name": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Display Name"
                    },
                    "form": {
                        "minLength": 1,
                        "title": "Form",
                        "type": "string"
                    },
                    "id": {
                        "minLength": 1,
                        "title": "Id",
                        "type": "string"
                    },
                    "source": {
                        "minLength": 1,
                        "title": "Source",
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "source",
                    "form"
                ],
                "title": "PrincipalWire",
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "ctx": {
                        "title": "Context",
                        "type": "object"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "title": "Location",
                        "type": "array"
                    },
                    "msg": {
                        "title": "Message",
                        "type": "string"
                    },
                    "type": {
                        "title": "Error Type",
                        "type": "string"
                    }
                },
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError",
                "type": "object"
            }
        },
        "securitySchemes": {
