{
    "components": {
        "schemas": {
            "AgentAnswer": {
                "description": "An ``Answer`` without its ``signal_ids``.\n\nAn agent cannot use the ids and pays tokens for every one, so the\nagent-facing surfaces return this.",
                "properties": {
                    "answer_type": {
                        "title": "Answer Type",
                        "type": "string"
                    },
                    "computed_at": {
                        "format": "date-time",
                        "title": "Computed At",
                        "type": "string"
                    },
                    "embedding_available": {
                        "title": "Embedding Available",
                        "type": "boolean"
                    },
                    "headline": {
                        "title": "Headline",
                        "type": "string"
                    },
                    "n_sessions": {
                        "title": "N Sessions",
                        "type": "integer"
                    },
                    "n_signals": {
                        "title": "N Signals",
                        "type": "integer"
                    },
                    "rows": {
                        "items": {
                            "$ref": "#/components/schemas/AgentAnswerRow"
                        },
                        "title": "Rows",
                        "type": "array"
                    }
                },
                "required": [
                    "answer_type",
                    "headline",
                    "rows",
                    "n_signals",
                    "n_sessions",
                    "embedding_available",
                    "computed_at"
                ],
                "title": "AgentAnswer",
                "type": "object"
            },
            "AgentAnswerRow": {
                "description": "A ranked row: the entity and its metric, without the ids behind it.",
                "properties": {
                    "label": {
                        "title": "Label",
                        "type": "string"
                    },
                    "value": {
                        "title": "Value",
                        "type": "integer"
                    }
                },
                "required": [
                    "label",
                    "value"
                ],
                "title": "AgentAnswerRow",
                "type": "object"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "title": "Detail",
                        "type": "array"
                    }
                },
                "title": "HTTPValidationError",
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "ctx": {
                        "title": "Context",
                        "type": "object"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "title": "Location",
                        "type": "array"
                    },
                    "msg": {
                        "title": "Message",
                        "type": "string"
                    },
                    "type": {
                        "title": "Error Type",
                        "type": "string"
                    }
                },
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError",
                "type": "object"
            }
        },
        "securitySchemes": {
            "BearerApiKey": {
                "description": "'Bearer <your API key>'.",
                "in": "header",
                "name": "Authorization",
                "type": "apiKey"
            },
            "TenantId": {
                "description": "Auth key: the tenant identifier the Bearer token belongs to.",
                "in": "header",
                "name": "x-baton-tenant-id",
                "type": "apiKey"
            }
        }
    },
    "info": {
        "title": "Good Timing Console \u2014 ingest",
        "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/v0/metrics/demand_intents": {
            "get": {
                "description": "What agents arrive to do on a vendor, ranked by distinct sessions.",
                "operationId": "demand_intents",
                "parameters": [
                    {
                        "description": "The vendor surface being asked about (a facet, not the tenant scope).",
                        "in": "query",
                        "name": "vendor_id",
                        "required": true,
                        "schema": {
                            "description": "The vendor surface being asked about (a facet, not the tenant scope).",
                            "title": "Vendor Id",
                            "type": "string"
                        }
                    },
                    {
                        "description": "Extra fields to return. 'signal_ids' adds, per row and in total, the ids of the signals behind each count. An agent does not need them.",
                        "in": "query",
                        "name": "include",
                        "required": false,
                        "schema": {
                            "description": "Extra fields to return. 'signal_ids' adds, per row and in total, the ids of the signals behind each count. An agent does not need them.",
                            "items": {
                                "const": "signal_ids",
                                "type": "string"
                            },
                            "title": "Include",
                            "type": "array"
                        }
                    },
                    {
                        "description": "Window on captured_at, in days back from now. Omit for all-time.",
                        "in": "query",
                        "name": "window_days",
                        "required": false,
                        "schema": {
                            "anyOf": [
                                {
                                    "exclusiveMinimum": 0,
                                    "type": "integer"
                                },
                                {
                                    "type": "null"
                                }
                            ],
                            "description": "Window on captured_at, in days back from now. Omit for all-time.",
                            "title": "Window Days"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AgentAnswer"
                                }
                            }
                        },
                        "description": "Successful Response"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        },
                        "description": "Validation Error"
                    }
                },
                "security": [
                    {
                        "TenantId": []
                    },
                    {
                        "BearerApiKey": []
                    }
                ],
                "summary": "Demand Intents",
                "tags": [
                    "metrics"
                ]
            }
        },
